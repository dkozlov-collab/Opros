
                        <!DOCTYPE html>
                        <html lang="en">
                        <head>
                            <meta charset="UTF-8">
                            <meta name="viewport" content="width=device-width, initial-scale=1.0">
							<style>
								body {
									background-color: white; /* Ensure the iframe has a white background */
								}

								
							</style>
                        </head>
                        <body>
                            <!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Форма передачи заявки — ТС ПиОТ</title>
<style>
  *{box-sizing:border-box}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       background:#f4f5f7;margin:0;padding:20px;color:#333}
  .container{max-width:650px;background:#fff;padding:30px;border-radius:12px;
             box-shadow:0 4px 12px rgba(0,0,0,.08);margin:0 auto}
  h2{text-align:center;color:#1a1a1a;margin:0 0 24px}
  .form-group{margin-bottom:18px}
  label{display:block;font-weight:500;margin-bottom:6px;font-size:14px}
  input[type=text],input[type=email],input[type=tel],input[type=number],select,textarea{
    width:100%;padding:10px 12px;border:1px solid #dcdfe6;border-radius:6px;
    font-size:14px;transition:border-color .2s;font-family:inherit}
  input:focus,select:focus,textarea:focus{border-color:#409eff;outline:none}
  input:invalid:not(:placeholder-shown){border-color:#e53e3e}
  textarea{resize:vertical;min-height:80px}
  .sub-block{background:#f8fafc;border-left:3px solid #3b82f6;padding:12px 15px;
             border-radius:6px;margin:10px 0 15px}
  .sub-block .kkt-title{font-size:13px;font-weight:600;color:#3b82f6;margin-bottom:10px}
  .checkbox-group{display:flex;align-items:center;gap:10px;margin-top:6px}
  .checkbox-group input[type=checkbox]{width:18px;height:18px;flex:none}
  button{width:100%;background:#2b6cb0;color:#fff;border:none;padding:12px;font-size:16px;
         font-weight:600;border-radius:6px;cursor:pointer;transition:background .2s;margin-top:10px}
  button:hover{background:#2c5282}
  button:disabled{background:#a0aec0;cursor:not-allowed}
  .btn-secondary{background:#718096;margin-top:15px}
  .btn-secondary:hover{background:#4a5568}
  #success-message{display:none;text-align:center;margin-top:20px}
  .success-text{color:#38a169;font-weight:600;font-size:18px;margin-bottom:15px}
  .error-text{color:#e53e3e;font-size:14px;margin-top:10px;display:none}
  .hint{font-size:12px;color:#718096;margin-top:4px}
</style>
</head>
<body>
<div class="container">
  <h2>Форма передачи заявки</h2>

  <form id="iotForm" novalidate-off>
    <div class="form-group">
      <label for="lpEmployee">ФИО сотрудника LP *</label>
      <input type="text" id="lpEmployee" name="lpEmployee" required autocomplete="name"
             placeholder="Иванов Иван Иванович">
    </div>

    <div class="form-group">
      <label for="priority">Приоритет *</label>
      <select id="priority" name="priority" required>
        <option value="" disabled selected>Выберите приоритет</option>
        <option>Низкий</option><option>Средний</option>
        <option>Высокий</option><option>Критический</option>
      </select>
    </div>

    <div class="form-group">
      <label for="orgName">Наименование организации (ООО/ИП) *</label>
      <input type="text" id="orgName" name="orgName" required placeholder="ООО «Ромашка»">
    </div>

    <div class="form-group">
      <label for="inn">ИНН *</label>
      <input type="text" id="inn" name="inn" required inputmode="numeric"
             pattern="\d{10}|\d{12}" maxlength="12" placeholder="7701234567">
      <div class="hint">10 цифр для юрлица, 12 — для ИП</div>
    </div>

    <div class="form-group">
      <label for="contactName">Контактное лицо (ФИО) *</label>
      <input type="text" id="contactName" name="contactName" required placeholder="Петров Пётр Петрович">
    </div>

    <div class="form-group">
      <label for="phone">Телефон *</label>
      <input type="tel" id="phone" name="phone" required inputmode="tel"
             autocomplete="tel" placeholder="+7 900 123-45-67">
    </div>

    <div class="form-group">
      <label for="email">E-Mail *</label>
      <input type="email" id="email" name="email" required autocomplete="email"
             placeholder="client@example.ru">
    </div>

    <div class="form-group">
      <label for="cashCount">Кол-во касс для настройки ТС ПиОТ *</label>
      <input type="number" id="cashCount" name="cashCount" min="1" max="20" value="1" required>
      <div class="hint">Поля по каждой кассе появятся ниже автоматически</div>
      <div id="kktContainer"></div>
    </div>

    <div class="form-group">
      <label for="needVisitSelect">Нужен выезд *</label>
      <select id="needVisitSelect" name="needVisit" required>
        <option value="нет" selected>нет</option>
        <option value="да">да</option>
      </select>
      <div id="visitAddressBlock" class="sub-block" style="display:none">
        <label for="visitAddress">Адрес выезда *</label>
        <input type="text" id="visitAddress" name="visitAddress" placeholder="Город, улица, дом, офис">
      </div>
    </div>

    <div class="form-group">
      <label for="hasKep">Есть ли КЭП *</label>
      <select id="hasKep" name="hasKep" required>
        <option value="" disabled selected>Выберите</option>
        <option value="да">да</option>
        <option value="нет">нет</option>
      </select>
    </div>

    <div class="form-group">
      <div class="checkbox-group">
        <input type="checkbox" id="espRegistered" name="espRegistered">
        <label for="espRegistered" style="margin:0">Зарегистрирован в ЕСП</label>
      </div>
    </div>

    <div class="form-group">
      <div class="checkbox-group">
        <input type="checkbox" id="hasWifi" name="hasWifi">
        <label for="hasWifi" style="margin:0">Есть Wi-Fi</label>
      </div>
    </div>

    <div class="form-group">
      <label for="comment">Комментарий</label>
      <textarea id="comment" name="comment" placeholder="Дополнительная информация..."></textarea>
    </div>

    <button type="submit" id="submitBtn">Отправить заявку</button>
    <div class="error-text" id="errorText"></div>
  </form>

  <div id="success-message">
    <div class="success-text">Заявка отправлена и записана в таблицу</div>
    <button type="button" class="btn-secondary" id="resetBtn">Создать новую заявку</button>
  </div>
</div>

<script>
// ====== НАСТРОЙКА: URL веб-приложения Google Apps Script (…/exec) ======
const SCRIPT_URL = ''; // ← вставь сюда https://script.google.com/macros/s/.../exec

const form        = document.getElementById('iotForm');
const btn         = document.getElementById('submitBtn');
const errorText   = document.getElementById('errorText');
const cashCount   = document.getElementById('cashCount');
const kktBox      = document.getElementById('kktContainer');
const visitSelect = document.getElementById('needVisitSelect');
const visitBlock  = document.getElementById('visitAddressBlock');
const visitInput  = document.getElementById('visitAddress');

/* --- Блоки ККТ по количеству касс --- */
function kktTemplate(i){
  return `<div class="sub-block kkt-block">
    <div class="kkt-title">Касса №${i}</div>
    <div class="form-group"><label>РНМ</label>
      <input type="text" data-f="rnm" inputmode="numeric" placeholder="Регистрационный номер"></div>
    <div class="form-group"><label>ЗН ККТ</label>
      <input type="text" data-f="znKkt" placeholder="Заводской номер ККТ"></div>
    <div class="form-group"><label>ФН</label>
      <input type="text" data-f="fn" inputmode="numeric" placeholder="Номер фискального накопителя"></div>
    <div class="form-group" style="margin-bottom:0"><label>Модель ККТ</label>
      <input type="text" data-f="modelKkt" placeholder="Например: ПТК MSPOS-K"></div>
  </div>`;
}
function renderKkt(){
  const n = Math.min(20, Math.max(1, parseInt(cashCount.value, 10) || 1));
  let blocks = kktBox.querySelectorAll('.kkt-block');
  while (blocks.length > n){ blocks[blocks.length-1].remove(); blocks = kktBox.querySelectorAll('.kkt-block'); }
  for (let i = blocks.length; i < n; i++) kktBox.insertAdjacentHTML('beforeend', kktTemplate(i+1));
}
cashCount.addEventListener('input', renderKkt);

/* --- Адрес выезда --- */
function toggleVisit(){
  const yes = visitSelect.value === 'да';
  visitBlock.style.display = yes ? 'block' : 'none';
  visitInput.required = yes;               // ← была ошибка: адрес не был обязательным
  if (!yes) visitInput.value = '';
}
visitSelect.addEventListener('change', toggleVisit);

/* --- Отправка --- */
form.addEventListener('submit', async (e) => {
  e.preventDefault();
  errorText.style.display = 'none';

  if (!form.reportValidity()) return;

  if (!SCRIPT_URL || !/^https:\/\/script\.google\.com\//.test(SCRIPT_URL)){
    errorText.textContent = 'Не задан SCRIPT_URL — укажите адрес Apps Script (…/exec) в коде страницы.';
    errorText.style.display = 'block';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Отправка...';

  const data = Object.fromEntries(new FormData(form).entries());
  data.espRegistered = document.getElementById('espRegistered').checked ? 'да' : 'нет';
  data.hasWifi       = document.getElementById('hasWifi').checked ? 'да' : 'нет';
  data.createdAt     = new Date().toISOString();
  data.kkt = [...kktBox.querySelectorAll('.kkt-block')].map((b, i) => ({
    n:        i + 1,
    rnm:      b.querySelector('[data-f=rnm]').value.trim(),
    znKkt:    b.querySelector('[data-f=znKkt]').value.trim(),
    fn:       b.querySelector('[data-f=fn]').value.trim(),
    modelKkt: b.querySelector('[data-f=modelKkt]').value.trim()
  }));

  try {
    // no-cors нужен для Apps Script: ответ будет opaque, статус прочитать нельзя.
    // Content-Type text/plain — чтобы не улетел preflight OPTIONS.
    await fetch(SCRIPT_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(data)
    });
    form.style.display = 'none';
    document.getElementById('success-message').style.display = 'block';
  } catch (err) {
    errorText.textContent = 'Ошибка отправки: ' + err.message + '. Проверьте соединение.';
    errorText.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Отправить заявку';
  }
});

/* --- Сброс --- */
document.getElementById('resetBtn').addEventListener('click', () => {
  form.reset();
  cashCount.value = 1;
  renderKkt();
  toggleVisit();
  form.style.display = 'block';
  document.getElementById('success-message').style.display = 'none';
  errorText.style.display = 'none';
  btn.disabled = false;
  btn.textContent = 'Отправить заявку';
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

renderKkt();
toggleVisit();
</script>
</body>
</html>

							<script>
                            	function doPost(e) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Заявки');
  const d = JSON.parse(e.postData.contents);
  const kkt = (d.kkt || []).map(k => `№${k.n}: РНМ ${k.rnm}, ЗН ${k.znKkt}, ФН ${k.fn}, ${k.modelKkt}`).join('\n');
  sheet.appendRow([
    new Date(), d.lpEmployee, d.priority, d.orgName, d.inn, d.contactName,
    d.phone, d.email, d.cashCount, kkt, d.needVisit, d.visitAddress || '',
    d.espRegistered, d.hasKep, d.hasWifi, d.comment || ''
  ]);
  return ContentService.createTextOutput(JSON.stringify({ ok: true }))
                       .setMimeType(ContentService.MimeType.JSON);
}
							</script>
                        </body>
                        </html>
                    
